# Copiar a .env y completar. Nunca commitear .env con valores reales.

# Capa de datos
CACHE_DIR=data/cache
FIXTURES_DIR=data/fixtures/demo
# 1 = solo caché y fixtures, sin red
DEMO_MODE=0
OFFLINE=0

# NASA Earthdata (SMAP, IMERG, GRACE-FO, MODIS). POWER no las necesita.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENGINE_TIMEOUT_S=20
