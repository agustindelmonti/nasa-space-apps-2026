{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd web && npm ci",
  "buildCommand": "cd web && VITE_API_URL=/ npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{src/**,data/assumptions.yaml,data/glossary.yaml,data/forbidden_phrases.yaml,data/intents.yaml,data/fixtures/demo/engine_climate.json,data/fixtures/demo/SMAP_L4/**,data/fixtures/demo/GRACE_FO/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
