{
  "name": "rastrojo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen:types": "node scripts/gen-types.mjs",
    "build": "npm run gen:types && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
